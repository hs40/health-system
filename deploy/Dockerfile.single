# ============================================================
# 健康运动管理系统 · 单容器镜像（nginx + uvicorn + scheduler）
#
# 构建（在仓库根目录执行）：
#   docker build -f deploy/Dockerfile.single -t hs-app:v1.0.0 .
#
# 设计说明：
#   - 三个进程由 supervisord 托管，对外只暴露 80 端口（nginx）。
#   - nginx 托管前端静态资源，并把 /api/ 反代到本机 127.0.0.1:8000。
#   - 后端与调度器共用 /app/backend 作为工作目录（保证 ../secrets 可解析）。
#   - secrets/ 不打入镜像（和风天气私钥）；运行时通过 compose 卷挂载注入。
#     → Dockerfile 不 COPY secrets/，.dockerignore 排除 secrets/。
#     → compose: ./secrets:/app/secrets:ro
#   - .env 不打入镜像，运行时 env_file 注入。
# ============================================================

# ---------- Stage 1：前端构建 ----------
FROM node:22-alpine AS fe
WORKDIR /fe
COPY frontend/package.json ./
RUN npm install --no-audit --no-fund
COPY frontend/ ./
RUN npm run build

# ---------- Stage 2：运行时 ----------
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    TZ=Asia/Shanghai

RUN apt-get update && apt-get install -y --no-install-recommends \
        tzdata curl nginx supervisor ca-certificates \
    && ln -snf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime \
    && echo "Asia/Shanghai" > /etc/timezone \
    && rm -rf /var/lib/apt/lists/* \
    && rm -f /etc/nginx/sites-enabled/default

WORKDIR /app/backend

# 依赖层（利用层缓存）
COPY backend/pyproject.toml ./
RUN pip install --upgrade pip setuptools wheel

# 应用代码与迁移配置
COPY backend/app ./app
COPY backend/alembic.ini ./
RUN pip install -e .

# secrets/ 不打入镜像——运行时通过 compose 卷挂载（./secrets:/app/secrets:ro）。

# 前端静态资源
COPY --from=fe /fe/dist /usr/share/nginx/html

# 进程编排与反代配置
# nginx.single.conf 被 nginx.conf 的 http 块 include；其中的 map / log_format
# 必须留在 http 上下文，故单独一个片段拷到 conf.d 之外（见该文件头部说明）。
COPY deploy/nginx.http.single.conf /etc/nginx/hs-http.conf
COPY deploy/nginx.single.conf /etc/nginx/conf.d/hs.conf
COPY deploy/supervisord.single.conf /etc/supervisor/conf.d/hs.conf

# 构建期配置语法检查：nginx 的 fatal 只有在真正加载配置时才暴露。
# v3.4.0 把 log_format 写进 server 块，本地与 CI 全绿、容器却起不来——
# 因为 CI 只构建镜像、从不加载配置。这一步让同样的错误在构建时就失败。
#
# 判定口径：只有 ``nginx -t`` 输出 ``[emerg]`` / ``[error]`` 才算失败。
# 不直接看退出码——Debian 的 nginx.conf 带 ``user www-data;``，在任何
# 「非 root 或缺该用户」的环境里 -t 会因这个无关原因返回非零，那会把
# 一个无害的环境差异变成构建失败。``[warn]`` 同样放过。
RUN nginx -t -c /etc/nginx/nginx.conf > /tmp/nginx-t.log 2>&1 || true; \
    if grep -qE '\[(emerg|error)\]' /tmp/nginx-t.log; then \
        echo "nginx 配置校验失败：" ; cat /tmp/nginx-t.log ; exit 1 ; \
    fi ; \
    echo "nginx 配置校验通过" ; rm -f /tmp/nginx-t.log

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=25s --retries=3 \
    CMD curl -fsS http://127.0.0.1/api/ops/health || exit 1

CMD ["supervisord", "-n", "-c", "/etc/supervisor/supervisord.conf"]
