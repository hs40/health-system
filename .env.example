# ============================================================
# 健康运动管理系统 · 环境配置模板
# 复制为 .env 后填写。.env 不得提交到版本库。
#
# 注意：值后面**不要**写行尾注释（`KEY=value  # 说明`）。
# dotenv 会把 `# 说明` 当成值的一部分，导致路径/口令被污染。
# 注释请单独成行。
# ============================================================

# —— 运行 ——
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# —— 数据路径（容器内挂载点；本地开发时可改为 ./data/...）——
# 原始 Garmin 数据（读写挂载；append-only 由应用层保证）
RAW_DATA_DIR=/data/raw
# SQLite
DB_PATH=/data/db/health.db
# 审计日志（JSONL）
AUDIT_DIR=/data/audit

# —— Garmin（python-garminconnect，独立鉴权，不依赖插件 session）——
GARMIN_EMAIL=
GARMIN_PASSWORD=
GARMIN_IS_CN=true
GARMIN_TOKENSTORE=/data/garmin_tokens

# —— Tredict（Python 重写，对拍 Node 脚本）——
TREDICT_TOKEN=
TREDICT_API_BASE=https://www.tredict.com/api/oauth/v2

# —— LLM（DeepSeek，OpenAI 兼容协议）——
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL_DAILY=deepseek-chat
LLM_MODEL_REASONING=deepseek-reasoner

# —— 天气（和风天气 QWeather，Ed25519 JWT 鉴权）——
# 训练区域，中文地名（省+市+区）。用于查天气并注入日报的环境段。
# 不设置时使用 backend/app/config.py 的默认值；
# 设为空字符串会让查询失败，所以请「注释掉」，不要留空值。
# QWEATHER_LOCATION=
# 私钥路径：本地开发默认 ../secrets/qweather_ed25519_private.pem；
# 容器内由 docker-compose 覆盖为 /app/secrets/qweather_ed25519_private.pem。
# QWEATHER_PRIVATE_KEY_PATH=../secrets/qweather_ed25519_private.pem

# —— 风险规则（版本号进入审计；阈值均为「候选值待验证」，见 Plan §2.4）——
RISK_RULE_VERSION=0.2.0
# 候选阈值外置文件（A.5.2）：JSON，格式 {rule_id: {threshold_key: 值}}。
# 留空 = 用 backend/data/rule_thresholds.json，该文件不存在则用代码默认值。
# 样例见 backend/rule_thresholds.example.json。
# 用 `python -m app.domain.calibration_cli --file <path>` 可先验证再上线。
# RULE_THRESHOLDS_FILE=

# —— 力量器材（REQ-PLAN-003；默认已按实有器材设置，一般无需改）——
# 成对可调哑铃的单只档位（kg，JSON 数组）；DUMBBELL_IS_PAIR=true 表示成对
# DUMBBELL_WEIGHTS_KG=[2.5, 3, 4, 5.5, 6.5, 7, 9.5]
# DUMBBELL_IS_PAIR=true

# —— 钉钉日报推送（2026-10-26）——
# 群机器人 Webhook；留空 = 功能禁用（前端按钮显示但禁用、定时任务跳过推送）
DINGTALK_WEBHOOK=
# 加签模式密钥；关键词模式留空
DINGTALK_SECRET=
# 「查看完整报告」链接前缀（对外访问地址，公网域名）。
# 不设置时使用 backend/app/config.py 的默认值；NAS 部署在 .env 里显式设为对外域名。
APP_BASE_URL=http://hs.qingtianjian.com:18080

# —— 调度 ——
SCHED_TZ=Asia/Shanghai
# 每日 07:30
DAILY_JOB_CRON=30 7 * * *
# 每周一 09:00
WEEKLY_JOB_CRON=0 9 * * 1
# 每月 1 日 09:00
MONTHLY_JOB_CRON=0 9 1 * *
